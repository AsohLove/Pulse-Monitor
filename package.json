{
  "name": "Pulse-Monitor-api",
  "version": "1.0.0",
  "description": "Pulse is a REST API for monitoring website uptime, recording incidents, and serving a public status page",
  "main": "server.js",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env  src/server.js",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "migrate:test": "node --env-file=.env.test  scripts/migrate.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "seed:test": "node --env-file=.env.test scripts/seed.js",
    "reset-db": "node --env-file=.env.test scripts/reset-db.js",
    "test": "npm run reset-db && NODE_ENV=test node --test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0",
    "yamljs": "^0.3.0",
    "zod": "^4.4.3"
  }
}
